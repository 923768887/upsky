{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "prisma/**", "node_modules/.prisma/**"]
      }
    }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/api/index.ts" },
    { "source": "/docs/(.*)", "destination": "/api/index.ts" },
    { "source": "/auth/(.*)", "destination": "/api/index.ts" },
    { "source": "/users/(.*)", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ]
}
